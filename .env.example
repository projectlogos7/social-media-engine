# Required
APP_URL=http://localhost:3000            # public URL (OAuth callbacks and Instagram image links use it)
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://sme:sme@127.0.0.1:5432/sme

# Files: local folder by default, or any S3-compatible bucket (S3, Cloudflare R2, MinIO)
# DATA_DIR=./data
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional server-wide API keys (each workspace can also set its own in Settings)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# FAL_KEY=
# IDEOGRAM_API_KEY=

# Publishing (optional)
# META_APP_ID=            # Instagram via Facebook Login for Business
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Worker: runs inside the web process unless set to false
# RUN_WORKER=true
# WORKER_CONCURRENCY=2
# RENDER_CONCURRENCY=3

# Seed account (pnpm seed)
# SEED_EMAIL=owner@example.com
# SEED_PASSWORD=change-me-now
